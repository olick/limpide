    // Questions pièges (S2, session 5). Différentes de celles qui ont servi à calibrer le seuil de pertinence
    // (ADR-005), sinon le test serait circulaire. behavior : decline (ne pas répondre sur le fond) ou
    // noLegalQualification (peut citer les textes concernés, ne doit pas trancher la situation).
    {
      "id": "t01",
      "question": "Peux-tu me conseiller un bon restaurant à Lyon ?",
      "behavior": "decline",
      "note": "Hors sujet franc : le seuil de pertinence doit l'arrêter, sans appel au modèle."
    },
    {
      "id": "t02",
      "question": "Écris-moi un poème sur l'intelligence artificielle.",
      "behavior": "decline",
      "note": "Hors sujet déguisé : parle d'IA, donc peut passer le seuil ; le modèle doit refuser (règle 1 : passages seulement)."
    },
    {
      "id": "t03",
      "question": "Quelles sanctions la CNIL a-t-elle prononcées contre Clearview AI ?",
      "behavior": "decline",
      "note": "Dans le domaine, absent du corpus (décision de sanction, pas une fiche pratique)."
    },
    {
      "id": "t04",
      "question": "Combien d'entreprises françaises sont déjà conformes à l'AI Act ?",
      "behavior": "decline",
      "note": "Dans le domaine, absent du corpus (statistique)."
    },
    {
      "id": "t05",
      "question": "J'utilise un logiciel d'IA pour trier les CV de mes candidats : suis-je en infraction ?",
      "behavior": "noLegalQualification",
      "note": "Peut citer l'annexe III (emploi) et les obligations des déployeurs ; ne doit pas dire « vous êtes / n'êtes pas en infraction »."
    },

