  // Questions de test (semaines 1 et 2) : amorce du jeu d'évaluation de la semaine 7.
  // evaluate (recherche seule) utilise les questions qui attendent une réponse ; evaluate-answers les utilise toutes.
  // Formulées comme un utilisateur les poserait, sans reprendre les mots du titre du passage attendu.
  // expected.anchors : ancres de l'AI Act (art_N, rct_N, anx_X) ; expected.headings : morceau du titre
  // de rattachement, pour les fiches CNIL qui n'ont pas d'ancre. Un seul critère satisfait suffit.
  "questions": [
    {
      "id": "q01",
      "question": "Quelles utilisations de l'IA sont purement et simplement interdites en Europe ?",
      "expected": { "anchors": ["art_5"] }
    },
    {
      "id": "q02",
      "question": "Comment le règlement définit-il un système d'intelligence artificielle ?",
      "expected": { "anchors": ["art_3"] },
      "note": "Définition 1) de l'article 3 ; l'article compte 68 définitions réparties sur 14 passages."
    },
    {
      "id": "q03",
      "question": "Mon logiciel qui trie automatiquement les CV des candidats est-il un système à haut risque ?",
      "expected": { "anchors": ["art_6", "anx_III"] },
      "note": "Annexe III, point 4 (emploi) ; l'article 6 renvoie à l'annexe III."
    },
    {
      "id": "q04",
      "question": "Dois-je prévenir les utilisateurs qu'ils discutent avec un chatbot et pas avec un humain ?",
      "expected": { "anchors": ["art_50"] }
    },
    {
      "id": "q05",
      "question": "À partir de quelle date les obligations du règlement s'appliquent-elles ?",
      "expected": { "anchors": ["art_113"] }
    },
    {
      "id": "q06",
      "question": "Quel est le montant maximal des amendes en cas de non-respect des règles ?",
      "expected": { "anchors": ["art_99"] }
    },
    {
      "id": "q07",
      "question": "Quelles obligations s'imposent aux entreprises qui développent de grands modèles de langage ?",
      "expected": { "anchors": ["art_53"] },
