# .NET
bin/
obj/
*.user
.vs/
.idea/

# Environnement
.env

# Données locales
data/

# Secrets de la démo en ligne (seuls les modèles .example sont versionnés)
.env.*
!.env*.example

# Airflow local (pipelines/airflow) : journaux et configuration générés
pipelines/airflow/logs/
pipelines/airflow/config/
pipelines/airflow/plugins/
__pycache__/

.claude
.venv/

# Terraform : dossier de travail et état (l'état peut contenir des secrets en clair ; distant à partir de la S6).
# Le fichier de verrouillage des fournisseurs (.terraform.lock.hcl) est versionné.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Identifiants de l'API OVHcloud si placés par erreur dans un dossier Terraform (à mettre dans ~/.ovh.conf).
ovh.conf
