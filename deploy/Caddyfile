# Reverse proxy de la démo : seul point d'entrée exposé sur Internet.
# SITE_ADDRESS = « :80 » tant qu'il n'y a pas de nom de domaine (HTTP sur l'adresse IP) ;
# = « limpide-ia.fr » (par exemple) ensuite : Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt).
{$SITE_ADDRESS} {
	encode gzip
	# Blazor Server passe par WebSocket : Caddy le relaie sans configuration particulière.
	reverse_proxy web:8080
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Back office (ADMIN_ADDRESS, ex. « admin.limpide-ia.fr ») : adresse séparée, son propre certificat. L'accès est
# protégé par l'application (connexion OpenID Connect, liste d'administrateurs) ; vide ou absent : bloc inactif.
{$ADMIN_ADDRESS} {
	encode gzip
	reverse_proxy admin:8080
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Supervision (GRAFANA_ADDRESS, ex. « grafana.limpide-ia.fr », ADR-018) : Grafana, joint sur le réseau de la démo.
# Sous-domaine à part, pas un chemin du back office : le navigateur isole les sites par domaine, une faille de Grafana
# ne peut pas agir dans le back office avec la session de l'administrateur. Grafana gère sa propre connexion Microsoft
# (même personne autorisée que le back office). Vide ou absent : bloc inactif (secours : Grafana fermé au public).
{$GRAFANA_ADDRESS} {
	encode gzip
	# Mot de passe « admin » (API) : jamais depuis Internet (essais en continu, ou blocage du compte) ; par tunnel SSH
	# seulement, directement sur le port de Grafana.
	@motdepasse header_regexp Authorization (?i)^basic\s
	respond @motdepasse "Authentification par mot de passe réservée au tunnel SSH." 403
	# Métriques internes de Grafana : servies sans authentification ; personne ne les lit.
	respond /metrics 404
	reverse_proxy grafana:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Adresse(s) redirigée(s) vers SITE_ADDRESS (ex. domaine nu « limpide-ia.fr » → « www.limpide-ia.fr ») : une seule
# adresse canonique. Caddy obtient aussi le certificat de cette adresse, pour rediriger en HTTPS.
# REDIRECT_FROM vide ou absent : docker-compose.prod.yml passe une adresse inexistante, en HTTP (aucun certificat
# demandé), donc sans effet. Une variable vide n'est pas absente pour Caddy : la valeur par défaut est dans Compose.
{$REDIRECT_FROM:http://redirection-inactive.invalid} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
