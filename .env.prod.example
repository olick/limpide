# Secrets et réglages de la démo en ligne. Copier en .env.prod (jamais commité) et remplir.
# Pas de « $ » dans les valeurs : Docker Compose les interprète.
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=change-me
MISTRAL_API_KEY=change-me

# « :80 » sans nom de domaine (HTTP sur l'adresse IP) ; le nom de domaine ensuite (HTTPS automatique).
SITE_ADDRESS=:80
# Adresse redirigée (301) vers SITE_ADDRESS, ex. le domaine nu « limpide-ia.fr » ; vide : aucune redirection.
REDIRECT_FROM=
# Ports publiés sur la machine (en local, éviter les conflits : HTTP_PORT=8088).
HTTP_PORT=80
HTTPS_PORT=443
