# Secrets et réglages de la démo en ligne. Copier en .env.prod (jamais commité) et remplir.
# Pas de « $ » dans les valeurs : Docker Compose les interprète.
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=change-me
MISTRAL_API_KEY=change-me

# « :80 » sans nom de domaine (HTTP sur l'adresse IP) ; le nom de domaine ensuite (HTTPS automatique).
SITE_ADDRESS=:80
# Adresse redirigée (301) vers SITE_ADDRESS, ex. le domaine nu « limpide-ia.fr » ; vide : aucune redirection.
REDIRECT_FROM=
# Back office : adresse (vide : désactivé), fournisseur OpenID Connect et administrateur autorisé.
# Microsoft, comptes personnels : https://login.microsoftonline.com/consumers/v2.0
# Changer de fournisseur (Google, Pocket ID, Authelia...) = changer ces trois valeurs, pas le code.
ADMIN_ADDRESS=
ADMIN_OIDC_AUTHORITY=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
# Identifiant « émetteur#sujet », affiché par la page /refuse à la première connexion.
ADMIN_ALLOWED_USER=
# Ports publiés sur la machine (en local, éviter les conflits : HTTP_PORT=8088).
HTTP_PORT=80
HTTPS_PORT=443
