@page "/"
@using Limpide.Core.Protection
@using Limpide.Infrastructure
@using Limpide.Web.Components.Thread
@inject AnswerService Answers
@inject QuestionQuota Quota
@inject ILogger<Home> Logger
@inject GenerationSettings Generation
@inject Limpide.Infrastructure.Storage.AnswerLogStore AnswerLog
@inject Visit CurrentVisit
@inject QuestionThread Thread
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Limpide — l'AI Act et la CNIL, cartes sur table</PageTitle>

@* Fil de questions sans mémoire (ADR-022) : l'accueil tant que le fil est vide, puis les questions empilées, chacune
   traitée seule. L'avis sur une réponse remplace le fil le temps de l'écrire ; « Revenir à vos questions » le rend. *@
@if (feedbackFor is { } target)
{
    <div class="coupe-page avis-page">
        <button type="button" class="back-link" @onclick="BackToThread">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
            Revenir à vos questions
        </button>
        <h1 class="sr-only">Votre avis sur une réponse</h1>
        <FeedbackForm Attached="target.Result" />
    </div>
}
else if (Thread.Entries.Count == 0)
{
    <ThreadIntro OnExample="PickExample" />
}
else
{
    <h1 class="sr-only">Vos questions</h1>
    <div class="fil">
        @foreach (var entry in Thread.Entries)
        {
            <ThreadAnswer @key="entry.Id" Entry="entry" OnResume="Resume" OnFeedback="OpenFeedback" />
        }
    </div>
}

@* Région d'annonce présente dès le départ (une région créée avec son texte n'est souvent pas lue). *@
<p class="sr-only" role="status">@status</p>

@if (feedbackFor is null)
{
    @* Mention de l'article 50 : dans l'en-tête fixe (MainLayout). Le champ est fixé en bas de la fenêtre (section
       « composer » du gabarit), hors de la zone qui défile. *@
    <SectionContent SectionName="composer">
    <div class="composer">
    <form class="ask" @onsubmit="AskAsync">
        @if (Thread.Entries.Count > 0)
        {
            <p class="seule"><strong>Chaque question est traitée seule</strong> : redonnez le contexte.</p>
        }
        @* Champ compact, pour tenir entier jusqu'à 320 × 568 (ADR-022) : étiquette lue par les lecteurs d'écran, bouton
           dans le cadre, Entrée pour envoyer et Maj+Entrée pour aller à la ligne (limpide.js), limites affichées
           seulement à leur approche. Le champ reste modifiable pendant l'attente : on peut préparer la suite. *@
        <label for="question" class="sr-only">Votre question</label>
        <div class="champ">
            @* Inactif tant que la page n'est pas interactive : une saisie serait perdue au branchement de Blazor, et
               Entrée ferait un envoi natif qui recharge la page. *@
            <textarea id="question" rows="1" maxlength="@MaxLength" enterkeyhint="send" @ref="field"
                      disabled="@(!RendererInfo.IsInteractive)"
                      placeholder="Ex. : Un chatbot doit-il dire qu'il est une IA ?"
                      aria-describedby="@(LimitsShown ? "question-limites" : null)"
                      @bind="question" @bind:event="oninput"></textarea>
            @* aria-disabled plutôt que disabled pendant l'attente : le bouton garde le focus et son nom. *@
            <button type="submit" aria-disabled="@(busy ? "true" : null)" disabled="@(!RendererInfo.IsInteractive)">
                @if (!busy)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
                }
                @if (busy)
                {
                    <span>En cours…</span>
                }
                else
                {
                    <span>Poser<span class="libelle-long"> la question</span></span>
                }
            </button>
        </div>
        <noscript><p class="error">Limpide a besoin de JavaScript pour répondre.</p></noscript>
        @if (LimitsShown)
        {
            <p class="limites" id="question-limites"><span>@QuotaText</span><span class="compteur">@CounterText@if (CounterText.Length > 0) {<span class="sr-only"> caractères</span>}</span></p>
        }
        @* Erreur (quota, délai, panne) près du champ : visible même si le fil a défilé. *@
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        @* Conservation du texte (ADR-019), information à deux niveaux (ADR-022) : une ligne avant l'envoi, avec la case
           d'opposition ; le détail (masquage, adresse IP, destinataires) dans « Vos données ». *@
        <div class="conservation">
            <span>N'y mettez pas de donnée personnelle, la question est gardée @KeptQuestion.Retention.Days jours.</span>
            <label class="keep-choice"><input type="checkbox" @bind="doNotKeep" /> Ne pas conserver ma question</label>
            <a href="/confidentialite">Vos données</a>
        </div>
    </form>
    </div>
    </SectionContent>
}

@code {
    /// <summary>Longueur maximale d'une question, rappelée dans « Ce que fait Limpide ».</summary>
    public const int MaxLength = 500;

    /// <summary>Délai au-delà duquel la réponse est abandonnée.</summary>
    public static readonly TimeSpan AnswerTimeout = TimeSpan.FromSeconds(60);

    private string question = "";
    private bool busy;
    private string? error;
    private string status = "";
    private bool doNotKeep;
    private int? remaining;
    private DateTimeOffset remainingUntil;
    private ElementReference field;

    /// <summary>Question dont on donne son avis : le formulaire remplace le fil.</summary>
    private ThreadEntry? feedbackFor;

    // Après le rendu : placer le fil au début d'une question, y poser le focus, ou le poser dans le champ.
    private string? showEntry;
    private string? focusEntry;
    private bool focusField;
    private bool fitField; // texte changé par le code : la hauteur du champ suit (limpide.js)
    private bool focusFeedback;

    /// <summary>« Nouvelle question » du menu (/?nouvelle=1) : le fil repart de zéro.</summary>
    [SupplyParameterFromQuery(Name = "nouvelle")]
    public string? NewQuestion { get; set; }

    /// <summary>Adresse IP du visiteur (App.razor) ; sans elle, tous les visiteurs partagent un même quota.</summary>
    [CascadingParameter(Name = "ClientAddress")]
    private string? ClientAddress { get; set; }

    [Inject]
    private QuotaOptions QuotaSettings { get; set; } = default!;

    // Limites affichées seulement à leur approche (ADR-022) : le quota à partir de 3 questions restantes, le compteur à
    // partir de 400 caractères.
    private string QuotaText =>
        remaining is > 0 and <= 3 && DateTimeOffset.UtcNow < remainingUntil
            ? remaining == 1 ? "Il vous reste 1 question pour cette heure." : $"Il vous reste {remaining} questions pour cette heure."
            : "";

    private string CounterText => question.Length >= 400 ? $"{question.Length} / {MaxLength}" : "";

    private bool LimitsShown => QuotaText.Length > 0 || CounterText.Length > 0;

    protected override void OnParametersSet()
    {
        if (NewQuestion is null)
            return;

        Thread.Clear();
        feedbackFor = null;
        question = "";
        error = null;
        status = "";
        focusField = fitField = true;
        Navigation.NavigateTo("/", replace: true);
    }

    private void PickExample(string example)
    {
        question = example;
        focusField = fitField = true;
    }

    private void Resume(ThreadEntry entry)
    {
        question = entry.Question;
        error = null;
        focusField = fitField = true;
    }

    private void OpenFeedback(ThreadEntry entry)
    {
        feedbackFor = entry;
        focusFeedback = true;
    }

    private void BackToThread()
    {
        showEntry = focusEntry = feedbackFor?.Id;
        feedbackFor = null;
    }

    private async Task AskAsync()
    {
        if (busy)
            return;

        // Bouton toujours actif, contrôle à l'envoi : un bouton grisé sans explication ne dit pas quoi faire.
        var text = question.Trim();
        if (text.Length == 0)
        {
            error = "Écrivez d'abord votre question, ou choisissez un des exemples.";
            return;
        }
        // maxlength ne protège que le navigateur : la limite (et donc le coût) est aussi tenue ici, avant le quota.
        if (text.Length > MaxLength)
        {
            error = $"Votre question dépasse {MaxLength} caractères : raccourcissez-la.";
            return;
        }

        error = null;
        using var visitScope = CurrentVisit.Scope(Logger);
        CurrentVisit.QuestionAsked();
        Logger.QuestionReceived(text.Length);
        var quota = Quota.TryConsume(ClientAddress ?? "inconnue");
        if (!quota.Allowed)
        {
            // L'adresse IP n'est pas journalisée (donnée personnelle) : seulement le type de limite atteinte.
            Logger.LogInformation("Question refusée par le quota : {Verdict}", quota.Verdict);
            await SaveToLogAsync(AnswerLogEntry.Refused(
                quota.Verdict == QuotaVerdict.ClientLimitReached ? AnswerOutcome.QuotaVisitor : AnswerOutcome.QuotaDaily,
                text.Length, TraceId()), kept: null); // refusée : rien à améliorer, texte non gardé
            error = quota.Verdict == QuotaVerdict.ClientLimitReached
                ? $"Limite atteinte : {QuotaSettings.PerClientPerHour} questions par heure et par visiteur, pour maîtriser le coût "
                  + $"de cette démo publique. Nouvelle question possible dans {Duration(quota.RetryAfter)}."
                : "La démo a atteint son nombre maximal de questions pour aujourd'hui (budget fixé à l'avance). "
                  + $"Nouvelle question possible dans {Duration(quota.RetryAfter)}.";
            return;
        }

        remaining = quota.Remaining;
        remainingUntil = DateTimeOffset.UtcNow + quota.WindowResetsIn; // passé ce délai, le quota du visiteur repart à zéro
        var entry = Thread.Add(text);
        var kept = doNotKeep ? null : KeptQuestion.From(text);
        question = "";
        fitField = true;
        showEntry = entry.Id;
        status = "Recherche en cours, la réponse peut prendre plusieurs secondes.";
        busy = true;
        var started = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            using var timeout = new CancellationTokenSource(AnswerTimeout);
            var result = await Answers.AskAsync(text, timeout.Token);
            var cited = result.CitedPassages.Select(p => p.Id).ToHashSet();
            entry.AnswerHtml = AnswerMarkdown.ToHtml(result.Answer, cited, entry.Id + "-");
            // Un garde-fou déclenché est montré d'emblée : la transparence vaut surtout quand quelque chose cloche.
            entry.DetailOpen = result.Guardrails.Count > 0;
            entry.Result = result;
            focusEntry = entry.Id;
            status = "Réponse prête.";
            Logger.AnswerSteps(result, Generation.MinScore);
            await SaveToLogAsync(AnswerLogEntry.From(result, TraceId()), kept);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            // Jamais le texte de la question dans les messages : ils sont conservés et consultables (ADR-018).
            Logger.LogError(ex, "Échec de la réponse à une question de {Length} caractères", text.Length);
            await SaveToLogAsync(AnswerLogEntry.Failed(ex, text.Length, started.Elapsed, TraceId()), kept);
            // La question quitte le fil et revient dans le champ, sauf si le visiteur y prépare déjà la suite.
            Thread.Remove(entry);
            if (question.Length == 0)
                question = text;
            status = "";
            focusField = fitField = true;
            error = ex is OperationCanceledException
                ? "La réponse a pris trop de temps (plus de 60 secondes). Réessayez dans un instant."
                : "La réponse n'a pas pu être produite (service de recherche ou de génération indisponible). Réessayez dans un instant.";
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Après le rendu : la nouvelle question est placée en haut de la zone qui défile, puis, la réponse arrivée, le
    /// focus va sur son titre (le bouton désactivé pendant l'attente l'avait perdu ; un lecteur d'écran lit la suite).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showEntry is { } shown)
        {
            showEntry = null;
            await JS.InvokeVoidAsync("limpide.showQuestion", shown);
        }
        if (focusEntry is { } focused)
        {
            focusEntry = null;
            await JS.InvokeVoidAsync("limpide.focusQuestion", focused);
        }
        if (focusFeedback)
        {
            focusFeedback = false;
            await JS.InvokeVoidAsync("limpide.showForm", "feedback-title");
        }
        if (fitField)
        {
            fitField = false;
            await JS.InvokeVoidAsync("limpide.fitQuestion");
        }
        if (focusField)
        {
            focusField = false;
            await field.FocusAsync();
        }
    }

    /// <summary>
    /// Journal des réponses (ADR-018), avec le texte de la question s'il est conservé (ADR-019) : son échec ne doit
    /// jamais priver le visiteur de sa réponse.
    /// </summary>
    private async Task SaveToLogAsync(AnswerLogEntry entry, KeptQuestion? kept)
    {
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await AnswerLog.SaveAsync(entry, kept, timeout.Token);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            Logger.LogWarning(ex, "Journal des réponses : ligne « {Outcome} » non enregistrée", entry.Outcome);
        }
    }

    private static string? TraceId() => System.Diagnostics.Activity.Current?.TraceId.ToHexString();

    private static string Duration(TimeSpan delay) =>
        delay.TotalMinutes < 1 ? "moins d'une minute"
        : delay.TotalHours < 1 ? $"{Math.Ceiling(delay.TotalMinutes):0} min"
        : $"{(int)delay.TotalHours} h {delay.Minutes:00}";
}
