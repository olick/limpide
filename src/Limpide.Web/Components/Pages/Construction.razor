@page "/construction"
@using System.Globalization
@inject ArchitectureDecisions Decisions

<PageTitle>Comment il est construit — Limpide</PageTitle>

@* Comment il est construit, chapitre 2 du fil de lecture (ADR-022) : trois chiffres, puis les briques (TechStack.razor),
   certaines avec le choix qui compte et la décision qui l'explique. Le chemin d'une question est dans « Ce que fait
   Limpide », la mise à jour des textes dans sa propre page (MiseAJour.razor), l'index des décisions sur GitHub.
   Maquette : écrans F5-construction de la toile. *@
<div class="coupe-page construction">
    <h1>Comment il est construit</h1>
    <p class="lede">Chaque brique a été choisie, mesurée quand c'était possible ; les choix qui comptent sont
        documentés dans une décision qu'on peut relire.</p>

    <ul class="chiffres-cles" role="list" aria-label="En chiffres">
        @if (Decisions.All.Count > 0)
        {
            <li>
                <strong>@Decisions.All.Count.ToString(French)</strong>
                <span>décisions d'architecture écrites, chacune relisible</span>
            </li>
        }
        <li>
            <strong>1</strong>
            <span>serveur, en France</span>
        </li>
        @* Les modèles tournent sur les GPU de leurs fournisseurs : Limpide n'en loue aucun (ADR-012). *@
        <li>
            <strong>0</strong>
            <span>serveur GPU à louer&nbsp;: les modèles tournent chez OVHcloud et Mistral, payés à l'usage</span>
        </li>
    </ul>

    <section class="briques-bloc" aria-labelledby="co-briques">
        <h2 id="co-briques" class="titre-bloc">Les briques</h2>
        <p class="briques-chapeau">Groupées par rôle ; sous les choix qui comptent, la décision qui les explique.</p>
        <TechStack />
        <p class="lien-decisions"><a href="https://github.com/olick/limpide/blob/main/docs/adr/README.md">Les
            @(Decisions.All.Count > 0 ? Decisions.All.Count.ToString(French) + " " : "")décisions d'architecture, sur
            GitHub</a></p>
    </section>

    @* Fil de lecture (ADR-022) : la question qu'on se pose après cette page, et le chemin pour y répondre. *@
    <LaSuite Chapitre="2" />
</div>

@code {
    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");
}
