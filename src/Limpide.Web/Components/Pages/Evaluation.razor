@page "/evaluation"
@using Limpide.Core.Evaluation
@using Limpide.Infrastructure
@using static Limpide.Web.EvaluationText
@inject EvaluationReports Reports
@inject AnswerInstructions Instructions
@inject GenerationSettings Generation
@inject EmbeddingOptions Embedding
@inject EvaluationGateOptions Gate

<PageTitle>Résultats d'évaluation — Limpide</PageTitle>

@* Résultats d'évaluation, chapitre 3 du fil de lecture (ADR-022), lisible en une minute : six cartes (résultat, attendu,
   ce que ça ne dit pas), la méthode en quatre étapes, le moment où la barrière a servi. Le détail (tableau complet,
   seuils, moments, historique) est dans EvaluationDetail.razor. Chiffres lus dans les rapports (EvaluationText.cs) et
   la configuration de la barrière, jamais recopiés. Maquette : écrans F6-evaluation de la toile. *@
<div class="coupe-page evaluation">
    <h1>Résultats d'évaluation</h1>
    <p class="lede">Comment on mesure la qualité des réponses de Limpide, ce que donnent les mesures, et ce qu'elles ne
        disent pas.</p>
    @if (Current is { } run)
    {
        <p class="version-evaluee">Version en ligne, évaluée le @Day(run.Date)&nbsp;: consignes <code>@run.Prompt</code>,
            @PlainLanguage.ModelName(run.Model), recherche @PlainLanguage.EmbeddingName(run.Embedding).</p>
    }
    else
    {
        <p class="warning">
            Aucune évaluation publiée ne correspond encore à la version en ligne (consignes
            <code>@Instructions.Version</code>, modèle <code>@Generation.Model</code>, recherche
            <code>@Embedding.Label</code>) : son rapport n'a pas encore été ajouté au dépôt. Les évaluations des versions
            précédentes sont dans <a href="/evaluation/detail">le détail</a>.
        </p>
    }

    <p class="avertissement-juriste" role="note"><strong>Aucun juriste n'a relu ces résultats.</strong> Les contrôles et
        les relectures sont faits par des modèles.</p>

    @if (Current is { } served)
    {
        <section class="mesures-bloc" aria-labelledby="ev-mesures">
            <h2 id="ev-mesures" class="titre-bloc">Ce que donnent les mesures</h2>
            <ul class="mesures-cartes" role="list">
                @foreach (var m in Measures(served))
                {
                    <li>
                        @* Ponctuation cachée : un lecteur d'écran lit la carte en phrases distinctes, la limite comprise. *@
                        <span class="mesure-questions">@m.Questions<span class="sr-only">. </span></span>
                        <strong class="mesure-resultat">@m.Result<span class="sr-only">. </span></strong>
                        <span>Attendu&nbsp;: @m.Expected<span class="sr-only">. </span></span>
                        <span class="mesure-limite"><span class="mesure-limite-titre">Ce que ça ne dit pas<span class="sr-only"> : </span></span>@m.Short</span>
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="ev-comment">
        <h2 id="ev-comment" class="titre-bloc">Comment on mesure</h2>
        <ol class="commandes etapes-mesure" role="list">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var (title, text) = Steps[i];
                <li>
                    <span class="commande-tete"><span class="commande-num" aria-hidden="true">@(i + 1)</span><span class="sr-only">Étape @(i + 1) : </span><strong>@title</strong></span>
                    <span>@text</span>
                </li>
            }
        </ol>
    </section>

    @if (BlockedChange(Reports.Runs) is { } moment)
    {
        <section class="moment-cle" aria-labelledby="ev-moment">
            <p class="moment-chapeau">La barrière a servi · @moment.Date</p>
            <h2 id="ev-moment">@moment.Title</h2>
            <p>@moment.Text</p>
            @if (moment.Href is { } href)
            {
                <a href="@href">@moment.LinkText</a>
            }
        </section>
    }

    <p class="lien-detail"><a href="/evaluation/detail">Le détail des évaluations</a>&nbsp;: mesure par mesure, les
        @Gate.Rules.Count seuils de la barrière, l'historique des @Reports.Runs.Count évaluations.</p>

    @* Fil de lecture (ADR-022) : la question qu'on se pose après cette page, et le chemin pour y répondre. *@
    <LaSuite Chapitre="3" />
</div>

@code {
    private EvaluationRun? Current => Reports.Latest(Instructions.Version, Generation.Model, Embedding.Label);

    private int? QuestionCount => Current?.Questions ?? Reports.Runs.FirstOrDefault()?.Questions;

    private (string Title, string Text)[] Steps =>
    [
        (QuestionCount is { } n ? $"{n} questions de test" : "Des questions de test",
            "Rejouées dès qu'un changement peut modifier les réponses, par la même chaîne que la démo."),
        ("Un verdict automatique", "Vérifiée, échec, ou à relire quand le contrôle ne sait pas trancher."),
        ("Un second modèle relit", "Il signale les réponses qui déforment les textes cités : il trie, il ne décide pas seul."),
        ("La barrière", $"{Gate.Rules.Count(r => r.Blocking)} seuils bloquants : un seul manqué, et la modification ne part pas en ligne."),
    ];
}
