@inherits LayoutComponentBase
@inject IConfiguration Configuration

<main class="page">
    @Body
</main>

<footer class="site-footer">
    <p>
        Textes : <a href="https://eur-lex.europa.eu/legal-content/FR/TXT/HTML/?uri=OJ:L_202401689" target="_blank" rel="noopener noreferrer">règlement (UE) 2024/1689</a>
        (EUR-Lex, réutilisation selon la décision 2011/833/UE) et fiches pratiques IA de la
        <a href="https://www.cnil.fr/fr/les-fiches-pratiques-ia" target="_blank" rel="noopener noreferrer">CNIL</a>
        (CC-BY-ND 4.0). Extraits reproduits sans modification.
    </p>
    <p>Projet ouvert : <a href="https://github.com/olick/limpide" target="_blank" rel="noopener noreferrer">github.com/olick/limpide</a></p>
    @if (AdminUrl is { } admin)
    {
        <p><a href="@admin" rel="nofollow">Back office</a> (accès réservé à l'administrateur)</p>
    }
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Adresse du back office (Site:AdminUrl) ; en production, ADMIN_ADDRESS sans schéma (« admin.limpide-ia.fr ») :
    // HTTPS par défaut. Absente : pas de lien.
    private string? AdminUrl => Configuration["Site:AdminUrl"] switch
    {
        null or "" => null,
        var url when url.Contains("://") => url,
        var host => $"https://{host}",
    };
}
