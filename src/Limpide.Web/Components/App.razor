<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Limpide.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" ClientAddress="@clientAddress" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Seule requête HTTP de la visite : les questions passent ensuite par la connexion WebSocket.
    // L'adresse vient de X-Forwarded-For (Caddy), lu grâce à ASPNETCORE_FORWARDEDHEADERS_ENABLED.
    // Transmise à la partie interactive comme paramètre du composant racine : Blazor la protège contre la falsification.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? clientAddress => HttpContext?.Connection.RemoteIpAddress?.ToString();
}
