            new("pgvector", "recherche par le sens, dans PostgreSQL", null),
            new("Ollama", "fait tourner le modèle de vectorisation sur le serveur", "ollama"),
            new("bge-m3", "modèle multilingue qui transforme un texte en vecteur", null),
            new("Mistral AI", "rédaction des réponses (Medium 3.5), hébergé en Europe", "mistralai"),
        ]),
        ("Données et pipeline", [
            new("Apache Airflow", "mise à jour hebdomadaire des textes", "apacheairflow"),
            new("Python", "description du pipeline", "python"),
            new("Docker", "chaque composant dans son conteneur", "docker"),
            new("DbUp", "évolutions du schéma de la base", null),
        ]),
        ("Hébergement et sécurité", [
