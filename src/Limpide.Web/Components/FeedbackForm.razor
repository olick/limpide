@using Limpide.Core.Answering
@using Limpide.Core.Feedback
@using Limpide.Core.Protection
@using Limpide.Infrastructure.Storage
@inject FeedbackStore Store
@inject ILogger<FeedbackForm> Logger
@inject Visit CurrentVisit

<section class="feedback" aria-labelledby="@(General ? null : "feedback-title")" aria-label="@(General ? "Formulaire d'avis" : null)">
    @if (!General)
    {
        <h2 id="feedback-title" tabindex="-1">Votre avis <span class="label">facultatif, chaque question l'est aussi</span></h2>
    }

    @if (sent)
    {
        <p class="ok" role="status">Merci&nbsp;: votre retour est enregistré.</p>
    }
    else
    {
        <form @onsubmit="SendAsync">
            <label for="fb-understood">Qu'avez-vous compris de ce que fait Limpide&nbsp;?</label>
            <textarea id="fb-understood" rows="2" maxlength="@VisitorFeedback.MaxLength" disabled="@sending" @bind="understood"></textarea>

            <label for="fb-misleading">Une réponse vous a-t-elle paru fausse ou trompeuse&nbsp;? Laquelle, et pourquoi&nbsp;?</label>
            <textarea id="fb-misleading" rows="2" maxlength="@VisitorFeedback.MaxLength" disabled="@sending" @bind="misleading"></textarea>

            <label for="fb-under-the-hood">La couche «&nbsp;Au fond&nbsp;» (comment la réponse a été produite) vous a-t-elle servi à quelque chose&nbsp;?</label>
            <textarea id="fb-under-the-hood" rows="2" maxlength="@VisitorFeedback.MaxLength" disabled="@sending" @bind="underTheHood"></textarea>

            @if (Attached is not null)
            {
                <label class="checkbox">
                    <input type="checkbox" @bind="attach" disabled="@sending" />
                    Joindre ma question et la réponse obtenue («&nbsp;@Shorten(Attached.Question, 80)&nbsp;»)
                </label>
            }
            else if (!General)
            {
                <p class="hint">Après avoir posé une question, vous pourrez la joindre à votre avis.</p>
            }

            <p class="privacy">
                Vos réponses servent à améliorer Limpide et à constituer ses questions de test. Elles sont conservées
                12 mois, sans adresse IP ni identifiant@(General ? "." : " ; votre question n'est jointe que si vous cochez la case.")
                N'y écrivez pas de données personnelles.
            </p>

            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }

            <button type="submit" disabled="@sending">@(sending ? "Envoi…" : "Envoyer mon avis")</button>
        </form>
    }
</section>

@code {
    /// <summary>
    /// Réponse dont on donne son avis (« Donner mon avis sur cette réponse ») : jointe seulement si le visiteur coche
    /// la case, décochée par défaut (consentement, RGPD).
    /// </summary>
    [Parameter]
    public AnswerResult? Attached { get; set; }

    /// <summary>Avis général, sur la page « Votre avis » : le titre est celui de la page, aucune question à joindre.</summary>
    [Parameter]
    public bool General { get; set; }

    [CascadingParameter(Name = "ClientAddress")]
    private string? ClientAddress { get; set; }

    /// <summary>Anti-spam : quota propre aux retours, distinct de celui des questions.</summary>
    [Inject(Key = "feedback")]
    private QuestionQuota Quota { get; set; } = default!;

    private string? understood;
    private string? misleading;
    private string? underTheHood;
    private bool attach;
    private bool sending;
    private bool sent;
    private string? error;

    private async Task SendAsync()
    {
        error = null;
        var feedback = VisitorFeedback.From(understood, misleading, underTheHood, attach ? Attached : null);
        if (feedback is null)
        {
            error = "Répondez à au moins une des trois questions.";
            return;
        }

        if (!Quota.TryConsume(ClientAddress ?? "inconnue").Allowed)
        {
            error = "Trop d'envois en peu de temps : réessayez plus tard.";
            return;
        }

        sending = true;
        try
        {
            await Store.SaveAsync(feedback, CancellationToken.None);
            sent = true;
            using (CurrentVisit.Scope(Logger))
                Logger.FeedbackSent(feedback.Context is not null);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            Logger.LogError(ex, "Échec de l'enregistrement d'un retour");
            error = "Votre retour n'a pas pu être enregistré. Réessayez dans un instant.";
        }
        finally
        {
            sending = false;
        }
    }

    private static string Shorten(string text, int max) => text.Length <= max ? text : text[..(max - 1)] + "…";
}
