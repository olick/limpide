<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Limpide.Infrastructure\Limpide.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Mêmes secrets locaux que la console et le web (connexion PostgreSQL), plus ceux de la connexion (Admin:*). -->
    <UserSecretsId>f2dc7aaa-1b80-470f-a62b-ebae01422188</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\appsettings.shared.json" Link="appsettings.shared.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
