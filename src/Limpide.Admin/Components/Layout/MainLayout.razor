@inherits LayoutComponentBase
@inject IConfiguration Configuration

<header class="top">
    <a class="brand" href="/">Limpide · back office</a>
    <nav>
        <AuthorizeView Policy="@AdminAuthentication.Policy">
            <Authorized>
                <NavLink href="/versions">Versions et quarantaine</NavLink>
                <NavLink href="/retours">Retours</NavLink>
                <NavLink href="/journal">Journal</NavLink>
                <NavLink href="/reglages">Réglages</NavLink>
            </Authorized>
        </AuthorizeView>
        @if (Configuration["Site:DemoUrl"] is { Length: > 0 } demo)
        {
            <a href="@demo">Démo</a>
        }
    </nav>
    <AuthorizeView Policy="@AdminAuthentication.Policy">
        <Authorized>
            <span class="user">@context.User.Identity?.Name · <a href="/deconnexion">se déconnecter</a></span>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>
