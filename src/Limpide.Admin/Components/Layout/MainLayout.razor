@inherits LayoutComponentBase
@inject IConfiguration Configuration

<header class="top">
    <a class="brand" href="/">Limpide · back office</a>
    <nav>
        <AuthorizeView Policy="@AdminAuthentication.Policy">
            <Authorized>
                <NavLink href="/versions">Versions et quarantaine</NavLink>
                <NavLink href="/retours">Retours</NavLink>
                <NavLink href="/journal">Journal</NavLink>
                <NavLink href="/reglages">Réglages</NavLink>
                @* Grafana (ADR-018) : sa propre connexion Microsoft, même personne autorisée qu'ici. *@
                @if (SupervisionUrl is { } supervision)
                {
                    <a href="@supervision" target="_blank" rel="noopener">Supervision</a>
                }
            </Authorized>
        </AuthorizeView>
        @if (Configuration["Site:DemoUrl"] is { Length: > 0 } demo)
        {
            <a href="@demo">Démo</a>
        }
    </nav>
    <AuthorizeView Policy="@AdminAuthentication.Policy">
        <Authorized>
            <span class="user">@context.User.Identity?.Name · <a href="/deconnexion">se déconnecter</a></span>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Adresse de Grafana (Site:SupervisionUrl) ; en production, GRAFANA_ADDRESS sans schéma (« grafana.limpide-ia.fr »).
    private string? SupervisionUrl => Configuration["Site:SupervisionUrl"] switch
    {
        null or "" => null,
        var url when url.StartsWith("http", StringComparison.Ordinal) => url,
        var host => $"https://{host}/",
    };
}
