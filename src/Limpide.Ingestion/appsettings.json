{
  "Ingestion": {
    "CorpusPath": "corpus.json",
    "QuestionsPath": "eval/questions.json",
    "ResultsPath": "eval/results",
    "RawDataPath": "data/raw",
    "ExtractedDataPath": "data/extracted",
    "UserAgent": "Limpide/0.1 (+https://github.com/olick/limpide)",
    "DelayBetweenRequests": "00:00:01.500",
    "RequestTimeout": "00:01:00"
  },
  // Contrôles qualité (commande validate). Seuils calibrés le 2026-10-10 sur les 3 documents, avec une marge mesurée :
  // texte 26 798 à 640 907 caractères, ≈ 40 % de mots outils français, 4 à 12 % de passages hors bornes, 0 doublon,
  // 113 articles (AI Act), 8 et 17 intertitres (CNIL). Essai ponctuel : validate --Quality:MinSections=50
  "Quality": {
    "MinTextLength": 2000,
    "MinFrenchShare": 0.20,
    "MaxPassageCountChange": 0.30,
    "TargetMinLength": 500,
    "TargetMaxLength": 1500,
    "MaxOutOfBoundsShare": 0.20,
    "MaxDuplicateShare": 0.05,
    "MinArticles": 100,
    "MinSections": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
