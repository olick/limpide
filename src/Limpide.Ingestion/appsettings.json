{
  "Ingestion": {
    "CorpusPath": "corpus.json",
    "QuestionsPath": "eval/questions.json",
    "ResultsPath": "eval/results",
    "RawDataPath": "data/raw",
    "ExtractedDataPath": "data/extracted",
    "UserAgent": "Limpide/0.1 (+https://github.com/olick/limpide)",
    "DelayBetweenRequests": "00:00:01.500",
    "RequestTimeout": "00:01:00"
  },
  // Contrôles qualité (commande validate). Seuils calibrés le 2026-10-10 sur les 3 documents, avec une marge mesurée :
  // texte 26 798 à 640 907 caractères, ≈ 40 % de mots outils français, 0 doublon, 113 articles (AI Act), 8 et 17
  // intertitres (CNIL). Longueur recalibrée le 2026-10-11 sur le corpus élargi (18 pages) : 0 à 3,2 % de passages de
  // moins de 100 ou plus de 2 000 caractères. Essai ponctuel : validate --Quality:MinSections=50
  "Quality": {
    "MinTextLength": 2000,
    "MinFrenchShare": 0.20,
    "MaxPassageCountChange": 0.30,
    "MinPassageLength": 100,
    "MaxPassageLength": 2000,
    "MaxAbnormalShare": 0.10,
    "MaxDuplicateShare": 0.05,
    "MinArticles": 100,
    "MinSections": 4
  },
  // Juge de fidélité (evaluate-answers, judge-calibrate ; S7), choisi par calibration le 2026-10-15 sur 37 réponses
  // relues, consignes judge/2 : Medium 3.5 détecte 8/9 erreurs connues pour 1 à 2 fausses alertes sur 13 (deux passes) ;
  // Large 3 : 5/9 et 3/13 ; Large 4 : réponses en blocs de réflexion illisibles par le client. Medium juge aussi ses
  // propres réponses : biais possible, contrôlé par la calibration (ses 2 erreurs connues détectées).
  // Autre juge : --Judge:Model=mistral-large-2512 ; tarifs en dollars par million, majoration UE (+10 %) comprise.
  "Judge": {
    "Endpoint": "https://api.eu.mistral.ai/v1",
    "Model": "mistral-medium-2604",
    "Temperature": 0,
    "MaxOutputTokens": 2000,
    "Prices": {
      "mistral-medium-2604": { "InputPerMillion": 1.65, "OutputPerMillion": 8.25 },
      "mistral-large-2512": { "InputPerMillion": 0.55, "OutputPerMillion": 1.65 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
