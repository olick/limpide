{
  "ConnectionStrings": {
    // Mot de passe hors du dépôt : `dotnet user-secrets` en local, variable ConnectionStrings__Rag ailleurs.
    "Rag": "Host=localhost;Port=5432;Database=rag;Username=rag"
  },
  "Ingestion": {
    "CorpusPath": "corpus.json",
    "QuestionsPath": "eval/questions.json",
    "RawDataPath": "data/raw",
    "ExtractedDataPath": "data/extracted",
    "UserAgent": "Limpide/0.1 (+https://github.com/olick/limpide)",
    "DelayBetweenRequests": "00:00:01.500",
    "RequestTimeout": "00:01:00"
  },
  "Embedding": {
    "Endpoint": "http://localhost:11434",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "BatchSize": 16,
    "IncludeHeading": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
