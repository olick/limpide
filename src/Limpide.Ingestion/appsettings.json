{
  "ConnectionStrings": {
    // Mot de passe hors du dépôt : `dotnet user-secrets` en local, variable ConnectionStrings__Rag ailleurs.
    "Rag": "Host=localhost;Port=5432;Database=rag;Username=rag"
  },
  "Ingestion": {
    "CorpusPath": "corpus.json",
    "QuestionsPath": "eval/questions.json",
    "RawDataPath": "data/raw",
    "ExtractedDataPath": "data/extracted",
    "UserAgent": "Limpide/0.1 (+https://github.com/olick/limpide)",
    "DelayBetweenRequests": "00:00:01.500",
    "RequestTimeout": "00:01:00"
  },
  "Embedding": {
    "Endpoint": "http://localhost:11434",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "BatchSize": 16,
    "IncludeHeading": true
  },
  "Generation": {
    // Mistral, inférence UE (ADR-004). Démo : mistral-medium-2604 (Medium 3.5) ; développement : mistral-small-2603.
    "Endpoint": "https://api.eu.mistral.ai/v1",
    "Model": "mistral-small-2603",
    "PassageCount": 5,
    "Temperature": 0,
    "MaxOutputTokens": 1000,
    // Dollars par million de tokens, majoration UE (+10 %) comprise, relevés le 2026-10-05.
    "Prices": {
      "mistral-small-2603": { "InputPerMillion": 0.165, "OutputPerMillion": 0.66 },
      "mistral-medium-2604": { "InputPerMillion": 1.65, "OutputPerMillion": 8.25 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
