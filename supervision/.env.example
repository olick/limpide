# Copier en supervision/.env (jamais commité). Pas de $ dans les valeurs (Docker Compose les interprète).
GRAFANA_ADMIN_PASSWORD=
# Comptes de lecture de Grafana (answer_log, base d'Airflow) et conteneur de la base de la démo : écrits par
# supervision/compte-lecture.sh, ne pas les remplir à la main.
GRAFANA_PG_PASSWORD=
GRAFANA_AIRFLOW_PASSWORD=
LIMPIDE_PG_HOTE=
# Alertes : adresse du webhook Discord (même salon que le DAG ; contient un jeton).
DISCORD_WEBHOOK_URL=
# Étiquette des alertes : poste ou serveur.
LIMPIDE_ENVIRONNEMENT=poste
# Réseau de la démo : limpide_default sur le poste, limpide-prod_default sur le serveur.
LIMPIDE_RESEAU=limpide_default
